{
  "openapi": "3.1.0",
  "servers": [{ "url": "/" }],
  "info": {
    "title": "SoroVault",
    "summary": "A contract interface (ABI) registry for Stellar/Soroban.",
    "description": "SoroVault fetches a deployed contract's WASM, decodes the interface embedded in it, versions it by WASM hash, and serves it. The ABI JSON is the project's public contract; `abi_version` is bumped if it ever changes incompatibly.",
    "license": { "name": "Apache-2.0", "identifier": "Apache-2.0" },
    "version": "1"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness",
        "description": "Does not touch the database or RPC.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "The process is serving.",
            "content": { "application/json": { "schema": {
              "type": "object",
              "properties": { "status": { "const": "ok" }, "version": { "type": "string" } },
              "required": ["status", "version"]
            }, "examples": { "live": { "$ref": "#/components/examples/Liveness" } } } }
          }
        }
      }
    },
    "/api/contracts": {
      "get": {
        "summary": "List or search contracts",
        "operationId": "listContracts",
        "parameters": [
          { "name": "q", "in": "query", "description": "Case-insensitive substring of the contract ID, its name, or a function, type or event name in its current interface.", "schema": { "type": "string" } },
          { "name": "function", "in": "query", "description": "Only contracts whose current interface declares a function with exactly this name. Repeatable; every name must match. Case-sensitive.", "schema": { "type": "array", "items": { "type": "string" } }, "style": "form", "explode": true },
          { "name": "type", "in": "query", "description": "Only contracts whose current interface declares a user-defined type with exactly this name. Repeatable; every name must match. Case-sensitive.", "schema": { "type": "array", "items": { "type": "string" } }, "style": "form", "explode": true },
          { "$ref": "#/components/parameters/network" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } }
        ],
        "responses": {
          "200": { "description": "One page of contracts.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContractList" }, "examples": { "zkvote": { "$ref": "#/components/examples/ContractList" } } } } },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      },
      "post": {
        "summary": "Register a contract",
        "description": "Fetches the contract's WASM, decodes its interface and stores it. Idempotent: registering a known contract re-verifies it, and records a new interface version if it was upgraded.",
        "operationId": "registerContract",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "properties": { "contract_id": { "$ref": "#/components/schemas/ContractID" } },
            "required": ["contract_id"],
            "additionalProperties": false
          }, "examples": { "zkvote": { "value": { "contract_id": "CDZZXVGUCLBUTE3WDD6TF2NXPTBPOYTVPPBBIZMSPVIQLUG226XJ4PAN" } } } } }
        },
        "responses": {
          "201": { "description": "Newly registered.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterResult" }, "examples": { "zkvote": { "$ref": "#/components/examples/RegisterResult" } } } } },
          "200": { "description": "Already registered; re-verified.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterResult" }, "examples": { "zkvote": { "$ref": "#/components/examples/ExistingRegisterResult" } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/NoInterface" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/contracts:batch": {
      "post": {
        "summary": "Register several contracts in one request",
        "description": "Registers up to 20 contracts, one after another, and reports one result per contract. The contracts are processed sequentially, so the batch draws on the registry's concurrency budget once per contract rather than all at once, and one failure does not stop the rest: every contract gets a result of its own, with the status code it would have had on its own request.",
        "operationId": "batchRegisterContracts",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "properties": { "contract_ids": { "type": "array", "items": { "$ref": "#/components/schemas/ContractID" }, "minItems": 1, "maxItems": 20 } },
            "required": ["contract_ids"],
            "additionalProperties": false
          }, "examples": { "two": { "value": { "contract_ids": ["CDZZXVGUCLBUTE3WDD6TF2NXPTBPOYTVPPBBIZMSPVIQLUG226XJ4PAN", "CDZZZPYQALFRBQAZD5KCW2SZK4ZF455PJVD7H53AGHXTWAJO4BYVPP2V"] } } } } }
        },
        "responses": {
          "200": { "description": "Every contract was processed; each result says what became of it.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BatchRegisterResult" }, "examples": { "mixed": { "$ref": "#/components/examples/BatchRegisterResult" } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/contracts/{id}": {
      "get": {
        "summary": "A contract's decoded interface",
        "operationId": "getContract",
        "parameters": [
          { "$ref": "#/components/parameters/id" },
          { "$ref": "#/components/parameters/network" },
          { "$ref": "#/components/parameters/wasmHash" }
        ],
        "responses": {
          "200": { "description": "The interface.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContractInterface" }, "examples": { "zkvote": { "$ref": "#/components/examples/ContractInterface" } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/contracts/{id}/source": {
      "put": {
        "summary": "Attach source repository metadata",
        "operationId": "updateContractSource",
        "parameters": [{ "$ref": "#/components/parameters/id" }, { "$ref": "#/components/parameters/network" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SourceRequest" } } } },
        "responses": {
          "200": { "description": "Updated contract metadata.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Contract" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/wasm/{hash}": {
      "get": {
        "summary": "Get a catalogued uploaded WASM interface",
        "operationId": "getWasmSpec",
        "parameters": [{ "$ref": "#/components/parameters/hash" }, { "$ref": "#/components/parameters/network" }],
        "responses": {
          "200": { "description": "The catalogued interface.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WasmSpec" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "summary": "Catalog uploaded code by WASM hash",
        "description": "Fetches and decodes uploaded code even when no deployed contract currently references it.",
        "operationId": "catalogWasm",
        "parameters": [{ "$ref": "#/components/parameters/hash" }],
        "responses": {
          "201": { "description": "Newly catalogued.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WasmCatalogResult" } } } },
          "200": { "description": "Already catalogued.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WasmCatalogResult" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/NoInterface" }
        }
      }
    },
    "/api/wasm/{hash}/contracts": {
      "get": {
        "summary": "List every contract running a given WASM",
        "description": "Many contracts share one WASM: every instance of a token template, every vault a factory deployed. This answers who else runs a given piece of code, which is the question a vulnerability in a shared WASM raises. With `ever=true` the listing also covers the contracts that ran the hash in the past and have since been upgraded; each result says whether the contract still runs it.",
        "operationId": "listWasmContracts",
        "parameters": [
          { "$ref": "#/components/parameters/hash" },
          { "$ref": "#/components/parameters/network" },
          { "name": "ever", "in": "query", "description": "Also list the contracts that ran the hash in the past, not only the ones running it now.", "schema": { "type": "boolean", "default": false } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } }
        ],
        "responses": {
          "200": { "description": "One page of contracts.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WasmContractList" }, "examples": { "shared": { "$ref": "#/components/examples/WasmContractList" } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/contracts/{id}/functions/{fn}": {
      "get": {
        "summary": "One function in detail",
        "operationId": "getFunction",
        "parameters": [
          { "$ref": "#/components/parameters/id" },
          { "name": "fn", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/network" },
          { "$ref": "#/components/parameters/wasmHash" }
        ],
        "responses": {
          "200": { "description": "The function.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FunctionDetail" }, "examples": { "hasVoted": { "$ref": "#/components/examples/FunctionDetail" } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/contracts/{id}/functions/{fn}/schema.json": {
      "get": {
        "summary": "A JSON Schema for a function's arguments",
        "description": "A JSON Schema (2020-12) describing the function's arguments object, derived from the contract's stored interface. A wallet or a dApp can render a form from it and validate the user's input before encoding it. Integers wider than 53 bits are decimal strings, addresses and byte strings carry patterns, options are nullable, and user-defined types become $defs.",
        "operationId": "getFunctionSchema",
        "parameters": [
          { "$ref": "#/components/parameters/id" },
          { "name": "fn", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/network" },
          { "$ref": "#/components/parameters/wasmHash" }
        ],
        "responses": {
          "200": { "description": "The schema.", "content": { "application/schema+json": { "schema": { "$ref": "#/components/schemas/JSONSchema" }, "examples": { "hasVoted": { "$ref": "#/components/examples/FunctionSchema" } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/contracts/{id}/functions": {
      "get": {
        "summary": "List a contract's function signatures",
        "operationId": "listFunctions",
        "description": "Returns function names and signatures without documentation or other interface details.",
        "parameters": [
          { "$ref": "#/components/parameters/id" },
          { "$ref": "#/components/parameters/network" },
          { "$ref": "#/components/parameters/wasmHash" }
        ],
        "responses": {
          "200": { "description": "Function names and signatures.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FunctionList" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/contracts/{id}/versions": {
      "get": {
        "summary": "Every stored interface version, newest first",
        "operationId": "listVersions",
        "parameters": [{ "$ref": "#/components/parameters/id" }, { "$ref": "#/components/parameters/network" }],
        "responses": {
          "200": { "description": "The versions.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VersionList" }, "examples": { "zkvote": { "$ref": "#/components/examples/VersionList" } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/contracts/{id}/refresh": {
      "post": {
        "summary": "Re-check a registered contract against the network",
        "operationId": "refreshContract",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "200": { "description": "Refreshed. `changed` is true when a new interface version was recorded.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterResult" }, "examples": { "unchanged": { "$ref": "#/components/examples/ExistingRegisterResult" } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/NoInterface" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/contracts/{id}/client.ts": {
      "get": {
        "summary": "A typed TypeScript client",
        "description": "Generated from the stored interface; builds on @stellar/stellar-sdk >= 14.",
        "operationId": "getTypeScriptClient",
        "parameters": [
          { "$ref": "#/components/parameters/id" },
          { "$ref": "#/components/parameters/network" },
          { "$ref": "#/components/parameters/wasmHash" },
          { "name": "download", "in": "query", "description": "Any value sets Content-Disposition: attachment.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "TypeScript source.", "content": { "text/plain": { "schema": { "type": "string" }, "example": "export const contractId = \\\"CDZZXVGUCLBUTE3WDD6TF2NXPTBPOYTVPPBBIZMSPVIQLUG226XJ4PAN\\\";\\nexport const wasmHash = \\\"c618dae264864ccf446a3c7db27da80c7c83e840131242cc2fe9cd32a2a20781\\\";\\n" } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/NoInterface" }
        }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "Registry statistics",
        "description": "Contract and interface-version counts per network, the most recently registered contract, and the most recent automatic refresh sweep. `last_refresh` is omitted when automatic refresh is not enabled.",
        "operationId": "getStats",
        "responses": {
          "200": { "description": "The registry's size at a glance.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Stats" }, "examples": { "stats": { "$ref": "#/components/examples/Stats" } } } } }
        }
      }
    },
    "/api/upgrades": {
      "get": {
        "summary": "Recent interface upgrades",
        "description": "One event per stored interface version that replaced an earlier one, newest first. A contract's first registration is not an upgrade, so it is excluded.",
        "operationId": "listUpgrades",
        "parameters": [
          { "$ref": "#/components/parameters/network" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } }
        ],
        "responses": {
          "200": { "description": "One page of upgrade events.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpgradeList" }, "examples": { "upgrades": { "$ref": "#/components/examples/UpgradeList" } } } } }
        }
      }
    },
    "/api/upgrades.atom": {
      "get": {
        "summary": "Recent interface upgrades as an Atom feed",
        "description": "The same events as /api/upgrades, in Atom 1.0 (RFC 4287), so feed readers can subscribe directly. A page with more events carries a rel=\"next\" link.",
        "operationId": "getUpgradesAtom",
        "parameters": [
          { "$ref": "#/components/parameters/network" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } }
        ],
        "responses": {
          "200": { "description": "An Atom 1.0 feed of recent upgrades.", "content": { "application/atom+xml": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "This document",
        "operationId": "getOpenAPI",
        "responses": { "200": { "description": "The OpenAPI document.", "content": { "application/json": { "schema": { "type": "object" }, "example": { "openapi": "3.1.0", "info": { "title": "SoroVault", "version": "1" } } } } } }
      }
    }
  },
  "components": {
    "parameters": {
      "id": { "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ContractID" } },
      "hash": { "name": "hash", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/WasmHash" } },
      "network": { "name": "network", "in": "query", "description": "Network namespace, e.g. testnet or public. Defaults to the network this instance's RPC serves.", "schema": { "type": "string" } },
      "wasmHash": { "name": "wasm_hash", "in": "query", "description": "Select a superseded interface version by WASM hash instead of the current one.", "schema": { "$ref": "#/components/schemas/WasmHash" } }
    },
    "responses": {
      "BadRequest": { "description": "Malformed input, such as an invalid contract ID.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "No such contract, version or function.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NoInterface": { "description": "The contract exists but has no interface to serve: a Stellar asset contract, or a module without a contractspecv0 section.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ServiceUnavailable": {
        "description": "The request could not be served now. Either the RPC endpoint serves a different network than NETWORK_PASSPHRASE, or the registry is already registering as many contracts as it is allowed to. In the second case the response carries a Retry-After header saying how long to wait before trying again.",
        "headers": {
          "Retry-After": { "description": "Seconds to wait before retrying. Present when the registry was busy.", "schema": { "type": "integer", "minimum": 1 } }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "examples": {
      "Liveness": { "value": { "status": "ok", "version": "dev" } },
      "Stats": { "value": {
        "networks": [
          { "network": "public", "contracts": 42, "versions": 57 },
          { "network": "testnet", "contracts": 18, "versions": 23 }
        ],
        "contracts": 60,
        "versions": 80,
        "latest_contract": {
          "contract_id": "CDZZXVGUCLBUTE3WDD6TF2NXPTBPOYTVPPBBIZMSPVIQLUG226XJ4PAN",
          "network": "testnet",
          "current_wasm_hash": "c618dae264864ccf446a3c7db27da80c7c83e840131242cc2fe9cd32a2a20781",
          "first_seen": "2026-08-07T12:00:00Z",
          "last_refreshed": "2026-08-07T12:00:00Z"
        },
        "last_refresh": { "checked": 12, "changed": 1, "failed": 0, "busy": 0, "missing": 2, "completed_at": "2026-08-07T12:05:00Z" }
      } },
      "UpgradeList": { "value": {
        "upgrades": [{
          "contract_id": "CDZZXVGUCLBUTE3WDD6TF2NXPTBPOYTVPPBBIZMSPVIQLUG226XJ4PAN",
          "network": "testnet",
          "old_wasm_hash": "c618dae264864ccf446a3c7db27da80c7c83e840131242cc2fe9cd32a2a20781",
          "new_wasm_hash": "0f5bd7b2e93efd1c07d2f5b1f0f2f2a1c0d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7",
          "observed_at": "2026-08-07T12:00:00Z"
        }],
        "total": 1,
        "limit": 50,
        "offset": 0
      } },
      "ContractList": { "value": {
        "contracts": [{
          "contract_id": "CDZZXVGUCLBUTE3WDD6TF2NXPTBPOYTVPPBBIZMSPVIQLUG226XJ4PAN",
          "network": "testnet",
          "current_wasm_hash": "c618dae264864ccf446a3c7db27da80c7c83e840131242cc2fe9cd32a2a20781",
          "first_seen": "2026-08-07T12:00:00Z",
          "last_refreshed": "2026-08-07T12:00:00Z"
        }],
        "total": 1,
        "limit": 50,
        "offset": 0
      } },
      "RegisterResult": { "value": {
        "contract": {
          "contract_id": "CDZZXVGUCLBUTE3WDD6TF2NXPTBPOYTVPPBBIZMSPVIQLUG226XJ4PAN",
          "network": "testnet",
          "current_wasm_hash": "c618dae264864ccf446a3c7db27da80c7c83e840131242cc2fe9cd32a2a20781",
          "first_seen": "2026-08-07T12:00:00Z",
          "last_refreshed": "2026-08-07T12:00:00Z"
        },
        "interface": {
          "abi_version": "1",
          "functions": [{ "name": "has_voted", "inputs": [{ "name": "nullifier", "type": { "kind": "bytes_n", "display": "BytesN<32>", "n": 32 } }], "outputs": [{ "kind": "bool", "display": "bool" }] }],
          "types": { "structs": [], "unions": [], "enums": [], "error_enums": [] },
          "events": []
        },
        "created": true,
        "changed": false
      } },
      "ExistingRegisterResult": { "value": {
        "contract": {
          "contract_id": "CDZZXVGUCLBUTE3WDD6TF2NXPTBPOYTVPPBBIZMSPVIQLUG226XJ4PAN",
          "network": "testnet",
          "current_wasm_hash": "c618dae264864ccf446a3c7db27da80c7c83e840131242cc2fe9cd32a2a20781",
          "first_seen": "2026-08-07T12:00:00Z",
          "last_refreshed": "2026-08-07T12:00:00Z"
        },
        "interface": {
          "abi_version": "1",
          "functions": [{ "name": "has_voted", "inputs": [{ "name": "nullifier", "type": { "kind": "bytes_n", "display": "BytesN<32>", "n": 32 } }], "outputs": [{ "kind": "bool", "display": "bool" }] }],
          "types": { "structs": [], "unions": [], "enums": [], "error_enums": [] },
          "events": []
        },
        "created": false,
        "changed": false
      } },
      "ContractInterface": { "value": {
        "contract_id": "CDZZXVGUCLBUTE3WDD6TF2NXPTBPOYTVPPBBIZMSPVIQLUG226XJ4PAN",
        "network": "testnet",
        "wasm_hash": "c618dae264864ccf446a3c7db27da80c7c83e840131242cc2fe9cd32a2a20781",
        "first_seen": "2026-08-07T12:00:00Z",
        "decoded_at": "2026-08-07T12:00:00Z",
        "current": true,
        "interface": {
          "abi_version": "1",
          "functions": [{ "name": "has_voted", "inputs": [{ "name": "nullifier", "type": { "kind": "bytes_n", "display": "BytesN<32>", "n": 32 } }], "outputs": [{ "kind": "bool", "display": "bool" }] }],
          "types": { "structs": [], "unions": [], "enums": [], "error_enums": [] },
          "events": []
        }
      } },
      "FunctionDetail": { "value": {
        "contract_id": "CDZZXVGUCLBUTE3WDD6TF2NXPTBPOYTVPPBBIZMSPVIQLUG226XJ4PAN",
        "network": "testnet",
        "wasm_hash": "c618dae264864ccf446a3c7db27da80c7c83e840131242cc2fe9cd32a2a20781",
        "signature": "fn has_voted(nullifier: BytesN<32>) -> bool",
        "function": {
          "name": "has_voted",
          "inputs": [{ "name": "nullifier", "type": { "kind": "bytes_n", "display": "BytesN<32>", "n": 32 } }],
          "outputs": [{ "kind": "bool", "display": "bool" }]
        }
      } },
