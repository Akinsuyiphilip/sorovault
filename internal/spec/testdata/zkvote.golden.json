  "functions": [
    {
      "name": "vote",
      "doc": "Cast a vote using a ZK Firma Digital Groth16 proof.\n\nThe proof is verified by a cross-contract call to the `zk_verifier`\ncontract.  Double-voting is prevented via the nullifier stored in\npersistent storage.\n\n### Public signals layout (5 × 32-byte big-endian scalars)\n\n\n| idx | meaning                                                       |\n|-----|---------------------------------------------------------------|\n| 0   | `pubkeyHash`     — Poseidon hash of the signing RSA pubkey    |\n| 1   | `nullifier`      — unique per voter; prevents double-voting   |\n| 2   | `ageAbove18`     — reveal flag (0 or 1); not checked here     |\n| 3   | `nullifierSeed`  — must equal `vote_params.vote_scope`        |\n| 4   | `signalHash`     — binding commitment (see identity_gate)     |\n\n* `voter`          – account casting the vote (must authorise the tx)\n* `proposal_index` – 0-based index into the proposals list\n* `pub_signals`    – 5 public circuit outputs (see table above)\n* `a`              – Groth16 proof poi",
      "inputs": [
        {
          "name": "voter",
          "type": {
            "kind": "address",
            "display": "Address"
          }
        },
        {
          "name": "proposal_index",
          "type": {
            "kind": "u32",
            "display": "u32"
          }
        },
        {
          "name": "pub_signals",
          "type": {
            "kind": "vec",
            "display": "Vec\u003cBytesN\u003c32\u003e\u003e",
            "element": {
              "kind": "bytes_n",
              "display": "BytesN\u003c32\u003e",
              "n": 32
            }
          }
        },
        {
          "name": "a",
          "type": {
            "kind": "bytes_n",
            "display": "BytesN\u003c64\u003e",
            "n": 64
          }
        },
        {
          "name": "b",
          "type": {
            "kind": "bytes_n",
            "display": "BytesN\u003c128\u003e",
            "n": 128
          }
        },
        {
          "name": "c",
          "type": {
            "kind": "bytes_n",
            "display": "BytesN\u003c64\u003e",
            "n": 64
          }
        }
      ],
      "outputs": [
        {
          "kind": "result",
          "display": "Result\u003c(), Error\u003e",
          "ok": {
            "kind": "void",
            "display": "()"
          },
          "error": {
            "kind": "error",
            "display": "Error"
          }
        }
      ]
    },
    {
      "name": "has_voted",
      "inputs": [
        {
          "name": "nullifier",
          "type": {
            "kind": "bytes_n",
            "display": "BytesN\u003c32\u003e",
            "n": 32
          }
        }
      ],
      "outputs": [
        {
          "kind": "bool",
          "display": "bool"
        }
      ]
    },
    {
      "name": "initialize",
      "doc": "One-time initialization.  Must be called before any votes can be cast.\n\n* `admin`                 – address that deployed this contract\n* `verifier_id`           – address of the deployed `zk_verifier` contract\n* `vote_params`           – campaign configuration\n* `proposal_descriptions` – human-readable label for each option",
      "inputs": [
        {
          "name": "admin",
          "type": {
            "kind": "address",
            "display": "Address"
          }
        },
        {
          "name": "verifier_id",
          "type": {
            "kind": "address",
            "display": "Address"
          }
        },
        {
          "name": "vote_params",
          "type": {
            "kind": "udt",
            "display": "VoteParams",
            "name": "VoteParams"
          }
        },
        {
          "name": "proposal_descriptions",
          "type": {
            "kind": "vec",
            "display": "Vec\u003cString\u003e",
            "element": {
              "kind": "string",
              "display": "String"
            }
          }
        }
      ],
      "outputs": [
        {
          "kind": "result",
          "display": "Result\u003c(), Error\u003e",
          "ok": {
            "kind": "void",
            "display": "()"
          },
          "error": {
            "kind": "error",
            "display": "Error"
          }
        }
      ]
    },
    {
      "name": "get_proposal",
      "inputs": [
        {
          "name": "index",
          "type": {
            "kind": "u32",
            "display": "u32"
          }
        }
      ],
      "outputs": [
        {
          "kind": "result",
          "display": "Result\u003cProposal, Error\u003e",
          "ok": {
            "kind": "udt",
            "display": "Proposal",
            "name": "Proposal"
          },
          "error": {
            "kind": "error",
            "display": "Error"
          }
        }
      ]
    },
